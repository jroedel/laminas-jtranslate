<?xml version="1.0"?>
<ruleset name="JTranslate">
    <description>PSR-12 plus a few house sniffs. Matches the host application's ruleset so a
    file moving between the two does not change shape.</description>

    <arg value="p"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="PSR12"/>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.Formatting.SpaceAfterNot"/>
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
        <properties>
            <property name="ignoreBlankLines" value="false"/>
        </properties>
    </rule>

    <!--
      Hand-written code only.

      language/ holds compiled catalogs that TranslationsTable::writePhpTranslationArrays()
      regenerates from the database. Their line length is the length of a translated
      phrase — up to the column's 2,000 characters — so a line-length rule there would
      fail on the next export and could never be satisfied by editing anything. They are
      build artifacts that happen to live in the tree.

      data/countries.json is vendored from mledoze/countries and is not ours to reformat.

      view/ is excluded for now because the .phtml templates predate the standard and
      reformatting them belongs with porting them, not with this sweep.
    -->
    <file>src</file>
    <file>config</file>
</ruleset>
